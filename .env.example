# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit secrets. See tech-architecture-flow §3.

# Anthropic API key used by any LLM-backed agent (model is set per-agent in
# config/agents/<agent>.yaml, never in code).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here
